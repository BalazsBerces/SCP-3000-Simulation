<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-independent simulation core: must never reference Godot. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Scp3008.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../game/scenarios/villager-sandbox/*.json" Link="Scenarios/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
